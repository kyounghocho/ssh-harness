# SSH Connection Settings (Single Host)
SSH_HOST=your_host_ip
SSH_PORT=22
SSH_USER=your_username

# Authentication (choose one)
SSH_KEY_PATH=~/.ssh/id_ed25519
# SSH_PASSWORD=***

# Optional: Default working directory
SSH_WORKDIR=~

# Optional: Connection timeout (seconds)
SSH_TIMEOUT=300

# Optional: Conda environment (bash/zsh only, NOT used automatically)
# SSH_CONDA_ENV=your_conda_env  # Only works on bash/zsh with Conda installed

# ============================================
# Multi-Host Setup for Agent Environments
# ============================================
# Uncomment and configure for multiple hosts
# SSH_HOST_1=192.168.1.10
# SSH_USER_1=user1
# SSH_PASS_1=password1  # Used for initial key injection

# SSH_HOST_2=192.168.1.20
# SSH_USER_2=user2
# SSH_PASS_2=password2

# SSH_HOST_3=192.168.1.30
# SSH_USER_3=user3
# SSH_PASS_3=password3

# Note: SSH_PASS_N is only used once for key injection via setup_ssh_access()
# After keys are injected, password is no longer needed.
